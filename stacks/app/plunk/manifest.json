{
  "name": "plunk",
  "category": "app",
  "description": "Open-source transactional email platform",
  "depends_on": [
    "postgres",
    "redis"
  ],
  "env": [
    {
      "name": "PLUNK_HOST",
      "default": "${BENTO_STACK_KEY}.${BASE_DOMAIN}",
      "prompt": "Plunk hostname"
    },
    {
      "name": "PLUNK_JWT_SECRET",
      "generate": "openssl rand -hex 32",
      "hide": true
    },
    {
      "name": "POSTGRES_PASSWORD",
      "from_state": "POSTGRES_PASSWORD"
    },
    {
      "name": "PLUNK_REDIS_DB",
      "generate": "case \"$BENTO_STACK_KEY\" in *-????????) echo $(( 5 + 0x$(printf %s \"$BENTO_STACK_KEY\" | md5sum | cut -c1-4) % 11 ));; *) echo 2;; esac"
    },
    {
      "name": "AWS_REGION",
      "default": "us-east-1",
      "prompt": "AWS SES region"
    },
    {
      "name": "AWS_ACCESS_KEY_ID",
      "default": "disabled",
      "prompt": "AWS SES access key (leave default if not using email yet — Plunk's API crashes on boot if this is blank, see packages/api/src/app/constants.ts upstream)"
    },
    {
      "name": "AWS_SECRET_ACCESS_KEY",
      "default": "disabled",
      "prompt": "AWS SES secret key",
      "hide": true
    },
    {
      "name": "AWS_SES_CONFIGURATION_SET",
      "default": "disabled",
      "prompt": "AWS SES configuration set name"
    },
    { "name": "PLUNK_CPU_LIMIT", "default": "1" },
    { "name": "PLUNK_MEM_LIMIT", "default": "512M" }
  ],
  "post_deploy_url": "https://${PLUNK_HOST}"
}
