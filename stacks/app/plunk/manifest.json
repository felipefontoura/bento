{
  "name": "plunk",
  "category": "app",
  "description": "Open-source transactional email platform",
  "depends_on": [
    "postgres",
    "redis"
  ],
  "env": [
    {
      "name": "PLUNK_HOST",
      "default": "${BENTO_STACK_KEY}.${BASE_DOMAIN}",
      "prompt": "Plunk dashboard hostname"
    },
    {
      "name": "PLUNK_API_HOST",
      "default": "api-${BENTO_STACK_KEY}.${BASE_DOMAIN}",
      "prompt": "Plunk API hostname"
    },
    {
      "name": "PLUNK_LANDING_HOST",
      "default": "www-${BENTO_STACK_KEY}.${BASE_DOMAIN}",
      "prompt": "Plunk landing page hostname"
    },
    {
      "name": "PLUNK_WIKI_HOST",
      "default": "docs-${BENTO_STACK_KEY}.${BASE_DOMAIN}",
      "prompt": "Plunk docs/wiki hostname"
    },
    {
      "name": "PLUNK_JWT_SECRET",
      "generate": "openssl rand -base64 32",
      "hide": true
    },
    {
      "name": "POSTGRES_PASSWORD",
      "from_state": "POSTGRES_PASSWORD"
    },
    {
      "name": "PLUNK_REDIS_DB",
      "generate": "case \"$BENTO_STACK_KEY\" in *-????????) echo $(( 5 + 0x$(printf %s \"$BENTO_STACK_KEY\" | md5sum | cut -c1-4) % 11 ));; *) echo 2;; esac"
    },
    {
      "name": "AWS_SES_REGION",
      "default": "us-east-1",
      "prompt": "AWS SES region"
    },
    {
      "name": "AWS_SES_ACCESS_KEY_ID",
      "default": "disabled",
      "prompt": "AWS SES access key (leave default if not using email yet — Plunk's API crashes on boot if this is blank)"
    },
    {
      "name": "AWS_SES_SECRET_ACCESS_KEY",
      "default": "disabled",
      "prompt": "AWS SES secret key",
      "hide": true
    },
    {
      "name": "SES_CONFIGURATION_SET",
      "default": "disabled",
      "prompt": "AWS SES configuration set name"
    },
    {
      "name": "S3_ACCESS_KEY_ID",
      "default": "disabled",
      "prompt": "AWS S3 access key (leave default if not using uploads yet — see docs/reference/plunk-s3.md)"
    },
    {
      "name": "S3_ACCESS_KEY_SECRET",
      "default": "disabled",
      "prompt": "AWS S3 secret key",
      "hide": true
    },
    {
      "name": "S3_BUCKET",
      "default": "${BENTO_STACK_KEY}-uploads",
      "prompt": "AWS S3 bucket name for uploads"
    },
    {
      "name": "DISABLE_SIGNUPS",
      "default": "true",
      "prompt": "Disable public signups (true/false)"
    },
    { "name": "EMAIL_RATE_LIMIT_PER_SECOND", "default": "1" },
    { "name": "AUTO_PROJECT_DISABLE", "default": "false" },
    { "name": "PLUNK_CPU_LIMIT", "default": "2" },
    { "name": "PLUNK_MEM_LIMIT", "default": "2048M" },
    { "name": "PLUNK_NTFY_CPU_LIMIT", "default": "0.25" },
    { "name": "PLUNK_NTFY_MEM_LIMIT", "default": "128M" }
  ],
  "post_deploy_url": "https://${PLUNK_HOST}"
}
